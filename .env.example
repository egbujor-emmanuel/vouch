# Base RPC (defaults to https://mainnet.base.org)
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Funded key for publishing ERC-8004 feedback. Leave empty for read-only.
VOUCH_PRIVATE_KEY=
VOUCH_AGENT_ID=

# Where the evidence files are served from (the feedbackURI base)
VOUCH_EVIDENCE_BASE_URL=

# Optional: Basescan API key, only needed to enumerate historical feedback
BASESCAN_API_KEY=
